scalar DateTime

enum OrderStatus {
  PENDING
  ACCEPTED
  SHIPPED
  DELIVERED
  CANCELLED
}

type Money {
  amount: Float!
  currency: String!
}

type Order {
  id: ID!
  customerName: String!
  status: OrderStatus!
  deliveryDate: DateTime
  # DEMO — breaking: uncomment to require a date for every order.
  # deliveryDate: DateTime!
  total: Money!
}

type Query {
  order(id: ID!): Order!
  orders(status: OrderStatus, skip: Int = 0, limit: Int = 20): [Order!]!
}
